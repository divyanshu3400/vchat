# Copy to .env (never commit .env) and load it in your shell or process manager.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Leave unset to use SQLite (local only).
DATABASE_URL=postgres://vchat:vchat-dev-only@localhost:5432/vchat
# Leave unset for the in-memory channel layer (one process only). Required in production.
REDIS_URL=redis://localhost:6379/0
